{
  "name": "unraveltao.github.io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "react-router dev",
    "content": "velite build",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "react-router typegen && tsc --noEmit",
