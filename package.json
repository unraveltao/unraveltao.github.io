    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@react-router/node": "^7",
    "isbot": "^5",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@react-router/dev": "^7",
    "@shikijs/rehype": "^4.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "typescript": "^5.9.3",
    "velite": "^0.4.0",
    "vite": "^7"
  }
}
