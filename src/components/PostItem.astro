---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="post-item">
  <a class="post-item__link" href={`/posts/${post.id}/`}>
    <span class="post-item__date">
      <time class="meta" datetime={formatDate(post.data.date)}>
        {formatDate(post.data.date)}
      </time>
      {post.data.draft && <span class="meta post-item__draft">草稿</span>}
    </span>
    <span class="post-item__title">{post.data.title}</span>
    <p class="post-item__summary">{post.data.summary}</p>
  </a>
</li>

<style>
  .post-item__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* 草稿只在 dev 出现（build 已过滤），角标不占版面：单色文字，无底色无边框 */
  .post-item__draft {
    margin-left: var(--s2);
    color: var(--accent);
  }

  .post-item__draft::before {
    content: '·';
    margin-right: var(--s2);
    color: var(--ink-400);
  }
</style>
