---
import { SITE_NAME, SITE_EMAIL, SITE_REPO } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner meta">
    <span>© {year} {SITE_NAME}</span>
    <span class="footer__sep">·</span>
    <a href="/rss.xml">rss</a>
    <span class="footer__sep">·</span>
    <a href={SITE_REPO} rel="me noopener" target="_blank">github</a>
    <span class="footer__sep">·</span>
    <a href={`mailto:${SITE_EMAIL}`}>mail</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: var(--s8) 0 var(--s12);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
    width: 100%;
    max-width: calc(var(--measure) + var(--s12));
    margin: 0 auto;
    padding: 0 var(--s6);
  }

  .footer__sep {
    color: var(--line);
  }

  .footer a {
    color: var(--ink-400);
    transition: color var(--dur) var(--ease);
  }

  .footer a:hover {
    color: var(--accent);
  }
</style>
