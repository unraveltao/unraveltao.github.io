---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, collectTags } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts).map(([tag]) => tag);

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签 #${tag} 下的全部文章。`}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-head__title">#{tag}</h1>
      <p class="meta">{posts.length} 篇</p>
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s24) 0 var(--s8);
  }

  .page-head__title {
    margin: 0;
    font-size: var(--text-h2);
    line-height: 1.2;
    font-weight: 600;
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }
</style>
