---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, collectTags } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="tags" description="全部标签。">
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-head__title">tags</h1>
      <p class="meta">{tags.length} 个</p>
    </header>

    <ul class="tag-list">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tag}/`}>
              <span class="tag">#{tag}</span>
              <span class="meta tag-list__count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s24) 0 var(--s8);
  }

  .page-head__title {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .tag-list li {
    border-bottom: 1px solid var(--line);
  }

  .tag-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s3) 0;
  }

  .tag-list a:hover .tag {
    color: var(--accent);
  }

  .tag-list__count {
    font-variant-numeric: tabular-nums;
  }
</style>
