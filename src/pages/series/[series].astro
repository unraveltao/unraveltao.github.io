---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { seriesName, seriesDescription } from '../../lib/series';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const keys = [...new Set(posts.map((p) => p.data.series).filter(Boolean))] as string[];

  return keys.map((key) => ({
    params: { series: key },
    props: {
      key,
      posts: posts
        .filter((p) => p.data.series === key)
        .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
    },
  }));
}

const { key, posts } = Astro.props;
const description = seriesDescription(key);
---

<BaseLayout title={seriesName(key)} description={description ?? `${seriesName(key)} 系列`}>
  <div class="wrap">
    <header class="page-head">
      <p class="meta">series</p>
      <h1 class="page-head__title">{seriesName(key)}</h1>
      {description && <p class="page-head__desc">{description}</p>}
      <p class="meta">{posts.length} 篇</p>
    </header>

    <ol class="series-list">
      {
        posts.map((post, i) => (
          <li>
            <span class="meta series-list__index">{String(i + 1).padStart(2, '0')}</span>
            <a href={`/posts/${post.id}/`}>
              <span class="series-list__title">{post.data.title}</span>
              <span class="series-list__summary">{post.data.summary}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: var(--s24) 0 var(--s8);
  }

  .page-head__title {
    margin: var(--s2) 0 0;
    font-size: var(--text-h2);
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .page-head__desc {
    margin: var(--s3) 0 var(--s4);
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--ink-600);
    max-width: 34em;
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .series-list li {
    display: flex;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--line);
  }

  .series-list__index {
    padding-top: 0.2em;
  }

  .series-list a {
    color: inherit;
  }

  .series-list__title {
    display: block;
    font-size: var(--text-h4);
    font-weight: 600;
    line-height: 1.5;
    transition: color var(--dur) var(--ease);
  }

  .series-list a:hover .series-list__title {
    color: var(--accent);
  }

  .series-list__summary {
    display: block;
    margin-top: var(--s1);
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--ink-600);
  }
</style>
