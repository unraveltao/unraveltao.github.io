---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 content/pages/about.mdx');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-head__title">{entry.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: var(--s24) 0 var(--s8);
  }

  .page-head__title {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
</style>
