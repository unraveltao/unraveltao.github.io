---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import { SITE_NAME, SITE_TAGLINE } from '../lib/site';

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured);
const rest = posts.filter((post) => post.id !== featured?.id).slice(0, 10);
---

<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <h1 class="hero__name">{SITE_NAME}</h1>
      <p class="hero__tagline">{SITE_TAGLINE}</p>
    </section>

    {
      featured && (
        <section class="featured">
          <p class="meta featured__label">selected</p>
          <a class="featured__link" href={`/posts/${featured.id}/`}>
            <h2 class="featured__title">{featured.data.title}</h2>
            <p class="featured__summary">{featured.data.summary}</p>
            <p class="meta">
              {formatDate(featured.data.date)} · {readingTime(featured.body ?? '')} min
            </p>
          </a>
        </section>
      )
    }

    <section class="recent">
      {rest.length > 0 ? <PostList posts={rest} /> : <p class="meta empty">还没有文章。</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: var(--s24) 0 var(--s16);
  }

  .hero__name {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    margin: var(--s3) 0 0;
    font-size: var(--text-lead);
    line-height: 1.7;
    color: var(--ink-600);
    max-width: 34em;
  }

  .featured {
    padding: var(--s8) 0 var(--s12);
    border-top: 1px solid var(--line);
  }

  .featured__label {
    margin: 0 0 var(--s4);
  }

  .featured__link {
    display: block;
    color: inherit;
  }

  .featured__title {
    margin: 0;
    font-size: var(--text-h2);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color var(--dur) var(--ease);
  }

  .featured__link:hover .featured__title {
    color: var(--accent);
  }

  .featured__summary {
    margin: var(--s3) 0 var(--s4);
    font-size: var(--text-small);
    line-height: 1.7;
    color: var(--ink-600);
    max-width: 38em;
  }

  .recent {
    padding-top: var(--s4);
  }

  .empty {
    padding: var(--s8) 0;
  }
</style>
